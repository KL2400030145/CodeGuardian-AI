APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=sqlite:///./codeguardian.db
# PostgreSQL example: postgresql+psycopg://codeguardian:CHANGE_ME@localhost:5432/codeguardian
# MySQL example: mysql+pymysql://codeguardian:CHANGE_ME@localhost:3306/codeguardian
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MAX_UPLOAD_MB=15
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
